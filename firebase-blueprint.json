{
  "entities": {
    "CustomerLead": {
      "title": "CustomerLead",
      "description": "A customer who sent an inquiry about clothing styles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "weddingDate": { "type": "string" },
        "occasion": { "type": "string" },
        "budget": { "type": "string" },
        "preferredColors": { "type": "array" },
        "preferredStyles": { "type": "array" },
        "notes": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "uploadedImages": { "type": "array" },
        "adminNotes": { "type": "string" },
        "whatsappSent": { "type": "boolean" }
      },
      "required": ["id", "name", "phone", "email", "timestamp", "status"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "An appointment booked by a custom groom",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "branch": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "occasion": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" },
        "adminNotes": { "type": "string" },
        "scanCount": { "type": "number", "description": "Number of times this ticket has been scanned by the camera" },
        "lastScannedAt": { "type": "string", "description": "ISO timestamp for when the ticket was last scanned" }
      },
      "required": ["id", "branch", "date", "time", "customerName", "customerPhone", "status", "timestamp"]
    },
    "SettingsDocument": {
      "title": "SettingsDocument",
      "description": "System settings and branding URLs",
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      },
      "required": ["id"]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "An uploaded image or video metadata recorded in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "uploadDate": { "type": "string" },
        "category": { "type": "string" },
        "fileType": { "type": "string" }
      },
      "required": ["id", "title", "fileName", "fileUrl", "uploadDate", "category", "fileType"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "CustomerLead",
      "description": "Customer leads received from inquiry forms"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Store booked appointments"
    },
    "/settings/{settingId}": {
      "schema": "SettingsDocument",
      "description": "Store branding material URLs and web photo customizations"
    },
    "/media/{mediaId}": {
      "schema": "MediaItem",
      "description": "Admin uploaded files directory log"
    }
  }
}
